{
  "version": "1.0.0",
  "policy": {
    "description": "Pre-commit hook bypass audit policy",
    "effective_date": "2025-01-27",
    "approval_required": 2,
    "emergency_contact": "@arkatom",
    "max_bypasses_per_month": 3
  },
  "bypass_events": [],
  "monthly_limits": {
    "warning": "This limit exists to detect patterns, not to enable bypassing",
    "max_bypasses_per_user": 3,
    "review_required_after": 2
  },
  "enforcement": {
    "auto_create_issue": true,
    "notify_security_team": true,
    "block_future_commits": false
  }
}